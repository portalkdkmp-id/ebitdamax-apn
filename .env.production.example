APP_NAME="EBITDA SIDIQ"
APP_ENV=production
APP_KEY=<APP_KEY_FROM_KUBERNETES_SECRET>
APP_DEBUG=false
APP_URL=https://<EBITDA_PRODUCTION_DOMAIN>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=<CLOUD_SQL_HOST>
DB_PORT=5432
DB_DATABASE=ebitdamax
DB_USERNAME=<DB_USERNAME_FROM_KUBERNETES_SECRET>
DB_PASSWORD=<DB_PASSWORD_FROM_KUBERNETES_SECRET>
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=<DOMAIN_OR_NULL>
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=<PRODUCTION_FILESYSTEM>
DOCUMENTS_DISK=<PRODUCTION_DOCUMENTS_FILESYSTEM>

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ebitda_cache:

REDIS_CLIENT=phpredis
REDIS_HOST=<REDIS_SERVICE>
REDIS_PASSWORD=<REDIS_PASSWORD_FROM_KUBERNETES_SECRET>
REDIS_PORT=6379

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

PORTAL_PEMBANGUNAN_BASE_URL=https://portalkdkmp.id
PORTAL_PEMBANGUNAN_SARPRAS_TOKEN=<TOKEN_FROM_KUBERNETES_SECRET>
PORTAL_PEMETAAN_BASE_URL=https://pemetaan-lahan.portalkdkmp.id

SSO_ENABLED=true
SSO_URL=<CENTRAL_SSO_URL>
SSO_CLIENT_ID=<SSO_CLIENT_ID>
SSO_CLIENT_SECRET=<SSO_CLIENT_SECRET_FROM_KUBERNETES_SECRET>
SSO_REDIRECT_URI=https://<EBITDA_PRODUCTION_DOMAIN>/oauth/callback

LARAVEL_OPTIMIZE=true
LARAVEL_STORAGE_LINK=false
